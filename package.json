{
  "name": "dino-tycoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Touch-first spiritual successor to DinoPark Tycoon, built as an iPhone PWA.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:art": "tsc --noEmit && vite build --mode art-preview --outDir dist-art",
    "preview": "vite preview --host",
    "test": "vitest run --exclude tests/perf.test.ts && vitest run tests/perf.test.ts",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "art:convert": "node scripts/art/convert_sprites.mjs",
    "art:check": "node scripts/art/convert_sprites.mjs --check",
    "art:environment": "node scripts/checks/environment-review.mjs",
    "art:review": "node scripts/checks/art-review.mjs",
    "art:integration": "node scripts/checks/art-integration.mjs",
    "art:ui": "node scripts/checks/art-ui.mjs",
    "art:offline": "node scripts/checks/art-offline.mjs",
    "art:motion:convert": "node scripts/art/convert_motion.mjs",
    "art:motion:check": "node scripts/art/convert_motion.mjs --check",
    "art:immersion": "node scripts/checks/immersion-prototype.mjs",
    "bench": "vitest run tests/perf.test.ts --silent=false"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
